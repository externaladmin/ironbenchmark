{
  "rewrites": [
    { "source": "/survey", "destination": "/ironbenchmark_survey.html" },
    { "source": "/ai-sales", "destination": "/ai-sales-survey.html" },
    { "source": "/dealer-response", "destination": "/dealer-response-survey.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|svg|ico|jpg|webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}

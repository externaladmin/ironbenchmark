{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/survey",
      "dest": "/ironbenchmark_survey.html"
    },
    {
      "src": "/ai-sales",
      "dest": "/ai-sales-survey.html"
    },
    {
      "src": "/dealer-response",
      "dest": "/dealer-response-survey.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
